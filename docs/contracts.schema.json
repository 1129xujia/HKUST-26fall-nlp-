{
  "$defs": {
    "AppConfig": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "const": "1",
          "default": "1",
          "title": "Config Version",
          "type": "string"
        },
        "seed": {
          "default": 42,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/DataConfig"
        },
        "models": {
          "$ref": "#/$defs/ModelsConfig"
        },
        "planning": {
          "$ref": "#/$defs/PlanningConfig"
        },
        "retrieval": {
          "$ref": "#/$defs/RetrievalOptions"
        },
        "quality": {
          "$ref": "#/$defs/QualityConfig"
        },
        "optimization": {
          "$ref": "#/$defs/OptimizationConfig"
        },
        "budget": {
          "$ref": "#/$defs/BudgetConfig"
        },
        "escalation": {
          "$ref": "#/$defs/EscalationConfig"
        },
        "paths": {
          "$ref": "#/$defs/PathsConfig"
        }
      },
      "title": "AppConfig",
      "type": "object"
    },
    "BudgetConfig": {
      "additionalProperties": false,
      "properties": {
        "max_latency_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Max Latency Seconds",
          "type": "number"
        },
        "max_total_tokens": {
          "default": 12000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        }
      },
      "title": "BudgetConfig",
      "type": "object"
    },
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "agent",
            "system"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "DataConfig": {
      "additionalProperties": false,
      "properties": {
        "passages_path": {
          "format": "path",
          "title": "Passages Path",
          "type": "string"
        },
        "examples_path": {
          "format": "path",
          "title": "Examples Path",
          "type": "string"
        },
        "source": {
          "default": "synthetic",
          "enum": [
            "synthetic",
            "multidoc2dial"
          ],
          "title": "Source",
          "type": "string"
        },
        "split": {
          "default": "mini",
          "enum": [
            "mini",
            "train",
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "chunk_size": {
          "default": 1200,
          "minimum": 1,
          "title": "Chunk Size",
          "type": "integer"
        },
        "chunk_overlap": {
          "default": 150,
          "minimum": 0,
          "title": "Chunk Overlap",
          "type": "integer"
        }
      },
      "title": "DataConfig",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "pass",
        "retry",
        "clarify",
        "escalate"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DialogueInput": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "current_message": {
          "minLength": 1,
          "title": "Current Message",
          "type": "string"
        },
        "dialogue_history": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "title": "Dialogue History",
          "type": "array"
        }
      },
      "required": [
        "conversation_id",
        "current_message"
      ],
      "title": "DialogueInput",
      "type": "object"
    },
    "EmbeddingConfig": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "hash",
          "default": "hash",
          "title": "Backend",
          "type": "string"
        },
        "model": {
          "const": "hash-token-v1",
          "default": "hash-token-v1",
          "title": "Model",
          "type": "string"
        },
        "dimensions": {
          "default": 256,
          "minimum": 8,
          "title": "Dimensions",
          "type": "integer"
        }
      },
      "title": "EmbeddingConfig",
      "type": "object"
    },
    "EscalationConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "EscalationConfig",
      "type": "object"
    },
    "EscalationPackage": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "conversation_id": {
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "current_message": {
          "minLength": 1,
          "title": "Current Message",
          "type": "string"
        },
        "dialogue_history": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "title": "Dialogue History",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Passage"
          },
          "title": "Evidence",
          "type": "array"
        },
        "query": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attempted_actions": {
          "items": {
            "type": "string"
          },
          "title": "Attempted Actions",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "evaluation_feedback": {
          "items": {
            "$ref": "#/$defs/EvaluationFeedback"
          },
          "title": "Evaluation Feedback",
          "type": "array"
        },
        "delivered_to_human": {
          "default": false,
          "title": "Delivered To Human",
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "conversation_id",
        "current_message",
        "dialogue_history"
      ],
      "title": "EscalationPackage",
      "type": "object"
    },
    "EvaluationExample": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test",
            "mini"
          ],
          "title": "Split",
          "type": "string"
        },
        "dialogue": {
          "$ref": "#/$defs/DialogueInput"
        },
        "reference_answers": {
          "items": {
            "type": "string"
          },
          "title": "Reference Answers",
          "type": "array"
        },
        "gold_citations": {
          "items": {
            "type": "string"
          },
          "title": "Gold Citations",
          "type": "array"
        },
        "gold_evidence_groups": {
          "items": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": "Gold Evidence Groups",
          "type": "array"
        },
        "grounding": {
          "items": {
            "$ref": "#/$defs/GroundingReference"
          },
          "title": "Grounding",
          "type": "array"
        },
        "expected_behavior": {
          "anyOf": [
            {
              "enum": [
                "answer",
                "clarify",
                "escalate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Behavior"
        },
        "source": {
          "default": "synthetic",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "split",
        "dialogue"
      ],
      "title": "EvaluationExample",
      "type": "object"
    },
    "EvaluationFeedback": {
      "additionalProperties": false,
      "properties": {
        "relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance",
          "type": "number"
        },
        "sufficiency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sufficiency",
          "type": "number"
        },
        "groundedness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Groundedness",
          "type": "number"
        },
        "dialogue_consistency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dialogue Consistency",
          "type": "number"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "missing_information": {
          "default": "",
          "title": "Missing Information",
          "type": "string"
        },
        "suggested_action": {
          "default": "",
          "title": "Suggested Action",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "clarification_question": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Question"
        },
        "suggested_queries": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Suggested Queries",
          "type": "array"
        }
      },
      "required": [
        "relevance",
        "sufficiency",
        "groundedness",
        "dialogue_consistency",
        "decision"
      ],
      "title": "EvaluationFeedback",
      "type": "object"
    },
    "GeneratedResponse": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "retrieval_round": {
          "default": 0,
          "minimum": 0,
          "title": "Retrieval Round",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ResponseStatus",
          "default": "answered"
        }
      },
      "required": [
        "answer"
      ],
      "title": "GeneratedResponse",
      "type": "object"
    },
    "GroundingReference": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Span Ids",
          "type": "array"
        }
      },
      "required": [
        "doc_id"
      ],
      "title": "GroundingReference",
      "type": "object"
    },
    "LLMConfig": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "mock",
          "default": "mock",
          "title": "Backend",
          "type": "string"
        },
        "model": {
          "const": "mock-extractive-v1",
          "default": "mock-extractive-v1",
          "title": "Model",
          "type": "string"
        }
      },
      "title": "LLMConfig",
      "type": "object"
    },
    "MockScenario": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "dialogue": {
          "$ref": "#/$defs/DialogueInput"
        },
        "config_overrides": {
          "additionalProperties": true,
          "title": "Config Overrides",
          "type": "object"
        },
        "feedback": {
          "items": {
            "$ref": "#/$defs/EvaluationFeedback"
          },
          "minItems": 1,
          "title": "Feedback",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/OptimizationAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "generation_modes": {
          "items": {
            "enum": [
              "extract",
              "incomplete"
            ],
            "type": "string"
          },
          "title": "Generation Modes",
          "type": "array"
        },
        "evaluation_delay_seconds": {
          "default": 0.0,
          "maximum": 5,
          "minimum": 0,
          "title": "Evaluation Delay Seconds",
          "type": "number"
        }
      },
      "required": [
        "name",
        "description",
        "dialogue"
      ],
      "title": "MockScenario",
      "type": "object"
    },
    "ModelsConfig": {
      "additionalProperties": false,
      "properties": {
        "llm": {
          "$ref": "#/$defs/LLMConfig"
        },
        "embedding": {
          "$ref": "#/$defs/EmbeddingConfig"
        }
      },
      "title": "ModelsConfig",
      "type": "object"
    },
    "OptimizationAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "rewrite_query",
            "add_sub_queries",
            "adjust_retrieval",
            "regenerate",
            "clarify",
            "escalate"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rewritten_query": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewritten Query"
        },
        "sub_queries": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Sub Queries",
          "type": "array"
        },
        "retrieval_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clarification_question": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Question"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "OptimizationAction",
      "type": "object"
    },
    "OptimizationConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_retries": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "stop_if_no_new_evidence": {
          "default": true,
          "title": "Stop If No New Evidence",
          "type": "boolean"
        }
      },
      "title": "OptimizationConfig",
      "type": "object"
    },
    "Passage": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "passage_id": {
          "minLength": 1,
          "title": "Passage Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "domain": {
          "default": "unknown",
          "title": "Domain",
          "type": "string"
        },
        "span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Span Ids",
          "type": "array"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "source": {
          "default": "synthetic",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "passage_id",
        "title",
        "text"
      ],
      "title": "Passage",
      "type": "object"
    },
    "PathsConfig": {
      "additionalProperties": false,
      "properties": {
        "index_dir": {
          "format": "path",
          "title": "Index Dir",
          "type": "string"
        },
        "results_dir": {
          "format": "path",
          "title": "Results Dir",
          "type": "string"
        }
      },
      "title": "PathsConfig",
      "type": "object"
    },
    "PlanningConfig": {
      "additionalProperties": false,
      "properties": {
        "use_history": {
          "default": true,
          "title": "Use History",
          "type": "boolean"
        },
        "rewrite": {
          "default": true,
          "title": "Rewrite",
          "type": "boolean"
        },
        "decompose": {
          "default": false,
          "title": "Decompose",
          "type": "boolean"
        }
      },
      "title": "PlanningConfig",
      "type": "object"
    },
    "QualityConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "relevance_threshold": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Relevance Threshold",
          "type": "number"
        },
        "sufficiency_threshold": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Sufficiency Threshold",
          "type": "number"
        },
        "groundedness_threshold": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Groundedness Threshold",
          "type": "number"
        },
        "dialogue_consistency_threshold": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Dialogue Consistency Threshold",
          "type": "number"
        }
      },
      "title": "QualityConfig",
      "type": "object"
    },
    "QueryPlan": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "current_message": {
          "minLength": 1,
          "title": "Current Message",
          "type": "string"
        },
        "dialogue_history": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "title": "Dialogue History",
          "type": "array"
        },
        "rewritten_query": {
          "minLength": 1,
          "title": "Rewritten Query",
          "type": "string"
        },
        "intent": {
          "default": "unknown",
          "title": "Intent",
          "type": "string"
        },
        "domain": {
          "default": "unknown",
          "title": "Domain",
          "type": "string"
        },
        "sub_queries": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Sub Queries",
          "type": "array"
        }
      },
      "required": [
        "conversation_id",
        "current_message",
        "rewritten_query"
      ],
      "title": "QueryPlan",
      "type": "object"
    },
    "ResponseStatus": {
      "enum": [
        "answered",
        "clarification_needed",
        "insufficient_evidence",
        "escalated",
        "error"
      ],
      "title": "ResponseStatus",
      "type": "string"
    },
    "RetrievalCandidate": {
      "additionalProperties": false,
      "properties": {
        "passage": {
          "$ref": "#/$defs/Passage"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/RetrievalHit"
          },
          "title": "Hits",
          "type": "array"
        },
        "fusion_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fusion Score"
        },
        "rerank_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Score"
        }
      },
      "required": [
        "passage",
        "hits"
      ],
      "title": "RetrievalCandidate",
      "type": "object"
    },
    "RetrievalHit": {
      "additionalProperties": false,
      "properties": {
        "passage": {
          "$ref": "#/$defs/Passage"
        },
        "source": {
          "enum": [
            "dense",
            "bm25"
          ],
          "title": "Source",
          "type": "string"
        },
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        }
      },
      "required": [
        "passage",
        "source",
        "query_id",
        "score",
        "rank"
      ],
      "title": "RetrievalHit",
      "type": "object"
    },
    "RetrievalOptions": {
      "additionalProperties": false,
      "properties": {
        "branches": {
          "items": {
            "enum": [
              "dense",
              "bm25"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Branches",
          "type": "array"
        },
        "per_branch_top_k": {
          "default": 10,
          "minimum": 1,
          "title": "Per Branch Top K",
          "type": "integer"
        },
        "fusion": {
          "default": "rrf",
          "enum": [
            "rrf",
            "interleave"
          ],
          "title": "Fusion",
          "type": "string"
        },
        "rrf_k": {
          "default": 60,
          "minimum": 1,
          "title": "Rrf K",
          "type": "integer"
        },
        "candidate_top_k": {
          "default": 10,
          "minimum": 1,
