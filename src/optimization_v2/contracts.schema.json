        },
        "bm25_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bm25 Rank"
        },
        "rrf_score": {
          "default": 0.0,
          "title": "Rrf Score",
          "type": "number"
        },
        "rerank_score": {
          "default": 0.0,
          "title": "Rerank Score",
          "type": "number"
        }
