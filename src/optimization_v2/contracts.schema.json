{
  "$defs": {
    "BudgetState": {
      "additionalProperties": false,
      "properties": {
        "used_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "title": "Used Tokens"
        },
        "elapsed_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        }
      },
      "title": "BudgetState",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "default": true,
          "title": "Generation",
          "type": "boolean"
        },
        "rewriting": {
          "default": true,
          "title": "Rewriting",
          "type": "boolean"
        },
        "hybrid": {
          "default": true,
          "title": "Hybrid",
          "type": "boolean"
        },
        "reranking": {
          "default": false,
          "title": "Reranking",
          "type": "boolean"
        },
        "retrievers": {
          "items": {
            "enum": [
              "dense",
              "bm25"
            ],
            "type": "string"
          },
          "title": "Retrievers",
          "type": "array"
        }
      },
      "title": "Capabilities",
      "type": "object"
    },
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "agent",
            "system"
          ],
