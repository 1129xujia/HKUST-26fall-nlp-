        "passage_id",
        "doc_id",
        "domain",
        "title",
        "section_title",
        "text",
        "span_ids",
        "source_retrievers",
        "matched_query"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExecutionOptions": {
      "additionalProperties": false,
      "description": "Request-local settings, separate from Part 2 RetrievalRequest.",
      "properties": {
        "dense_top_k": {
          "default": 100,
          "maximum": 500,
          "minimum": 0,
          "title": "Dense Top K",
          "type": "integer"
        },
        "bm25_top_k": {
          "default": 50,
          "maximum": 500,
          "minimum": 0,
          "title": "Bm25 Top K",
          "type": "integer"
        },
        "dense_weight": {
          "default": 1.0,
          "maximum": 10,
          "minimum": 0,
          "title": "Dense Weight",
          "type": "number"
        },
        "bm25_weight": {
          "default": 1.0,
          "maximum": 10,
          "minimum": 0,
          "title": "Bm25 Weight",
          "type": "number"
        },
        "rrf_k": {
          "default": 30,
          "maximum": 200,
          "minimum": 1,
          "title": "Rrf K",
          "type": "integer"
        },
        "candidate_top_k": {
          "default": 50,
          "maximum": 500,
          "minimum": 1,
          "title": "Candidate Top K",
          "type": "integer"
        },
        "final_top_k": {
          "default": 6,
          "maximum": 20,
          "minimum": 1,
          "title": "Final Top K",
          "type": "integer"
        },
        "rerank": {
          "default": false,
          "title": "Rerank",
          "type": "boolean"
        },
        "reranker_query_strategy": {
          "default": "current_first_user_history",
          "enum": [
            "identity",
            "current_first_user_history"
          ],
          "title": "Reranker Query Strategy",
          "type": "string"
        },
        "reranker_use_sub_queries": {
          "default": false,
          "title": "Reranker Use Sub Queries",
          "type": "boolean"
        },
        "reranker_skip_acknowledgements": {
          "default": true,
          "title": "Reranker Skip Acknowledgements",
          "type": "boolean"
        },
        "domain_filter": {
          "default": false,
          "title": "Domain Filter",
          "type": "boolean"
        }
      },
      "title": "ExecutionOptions",
      "type": "object"
    },
    "Feedback": {
      "additionalProperties": false,
      "description": "Accepts main EvaluationFeedback without requiring new upstream fields.",
      "properties": {
        "relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance",
          "type": "number"
        },
        "sufficiency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sufficiency",
          "type": "number"
        },
        "groundedness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Groundedness",
          "type": "number"
        },
        "dialogue_consistency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dialogue Consistency",
          "type": "number"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "missing_information": {
          "default": "",
          "title": "Missing Information",
          "type": "string"
        },
        "suggested_action": {
          "default": "",
          "title": "Suggested Action",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "clarification_question": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Question"
        },
        "suggested_queries": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Suggested Queries",
          "type": "array"
        },
        "failure_types": {
          "items": {
            "enum": [
              "answer_defect",
              "query_misunderstanding",
              "retrieval_coverage",
              "retrieval_balance",
              "evidence_ranking",
              "missing_user_information"
            ],
            "type": "string"
          },
          "title": "Failure Types",
          "type": "array"
        },
        "evidence_sufficient": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sufficient"
        },
        "preferred_retriever": {
          "anyOf": [
            {
              "enum": [
                "dense",
                "bm25"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Retriever"
        }
      },
      "required": [
        "relevance",
        "sufficiency",
        "groundedness",
        "dialogue_consistency",
        "decision"
      ],
      "title": "Feedback",
      "type": "object"
