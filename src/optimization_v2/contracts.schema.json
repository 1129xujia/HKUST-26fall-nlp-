        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "section_title": {
          "title": "Section Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Span Ids",
          "type": "array"
        },
        "source_retrievers": {
          "items": {
            "type": "string"
          },
          "title": "Source Retrievers",
          "type": "array"
        },
        "matched_query": {
          "title": "Matched Query",
          "type": "string"
